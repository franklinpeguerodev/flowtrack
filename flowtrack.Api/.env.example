# ==========================================================
# Flowtrack API - configuración local (NO versionar)
# Copia este archivo como ".env" y ajusta los valores.
# Formato: __ (doble guion bajo) equivale a : en la ruta de configuración.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.
# ==========================================================

# Cadena de conexión de MySQL (Pomelo.EntityFrameworkCore.MySql)
ConnectionStrings__Default=server=localhost;port=3306;database=flowtrack;Uid=root;Pwd=CAMBIAR_PASSWORD

# Clave de firma del JWT (usa un valor largo y aleatorio)
Jwt__key=CAMBIAR_POR_UNA_CLAVE_SECRETA_PROPIA
Jwt__Issuer=flowtrack.API
Jwt__Audience=flowtrack.Client
Jwt__ExpireMinutes=60
